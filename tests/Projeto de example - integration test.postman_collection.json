  "item": [
    {
      "name": "health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if( responseCode.code !== 200)\r",
                  "{\r",
                  "    throw new Error('Erro ao testar saude da do projeto. Teste sera interrompido !!');\r",
                  "}\r",
                  "\r",
                  "tests[\"Test OK\"] = responseCode.code === 200;"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url_api}}/Healthcheck",
              "host": [
                "{{base_url_api}}"
              ],
              "path": [
                "Healthcheck"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Retorna lista de examples",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verifica se o status da response é 200\r",
              "pm.test(\"Teste OK Status code\", function () {\r",
              "    pm.response.to.have.status(200);\r",
